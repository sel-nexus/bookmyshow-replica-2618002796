# TCP port used by the Express server.
PORT=3001
# File path for the durable SQLite database.
DATABASE_PATH=./auth-foundation.sqlite
# Secret used to sign session tokens; replace outside local development.
SESSION_SECRET=dev-secret-change-in-production
# Browser origin allowed to make credentialed development requests.
CORS_ORIGIN=http://localhost:3000
# Cookie policy; set false only for local HTTP development.
COOKIE_SECURE=false
