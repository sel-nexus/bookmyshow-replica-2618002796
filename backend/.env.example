# TCP port used by the Express server.
PORT=3001
# File path for the durable SQLite database.
DATABASE_PATH=./auth-foundation.sqlite
# Secret used to sign session tokens; replace outside local development.
SESSION_SECRET=
# Name of the secure HTTP-only session cookie.
SESSION_COOKIE_NAME=bms_session
# Browser origin allowed to make credentialed development requests.
CORS_ORIGIN=http://localhost:3000
# Cookie policy; set false only for local HTTP development.
COOKIE_SECURE=false
# Skip catalogue seed data only for clean-database E2E fixtures.
CATALOGUE_EMPTY=false
# Optional nonnegative delay in milliseconds before catalogue responses.
CATALOGUE_DELAY_MS=0
